/*====================================================
    Reservation Details Report
====================================================*/
SELECT
    C.name AS Customer_Name,
    M.title AS Movie_Title,
    H.hall_name AS Hall_Name,
    MT.seats,
    MT.reservation_date
FROM MovieTicket MT
JOIN Customers C
    ON MT.customer_id = C.customer_id
JOIN Movies M
    ON MT.movie_id = M.movie_id
JOIN Halls H
    ON MT.hall_id = H.hall_id;



/*====================================================
    Movie Statistics
====================================================*/
SELECT
    M.title,
    COUNT(MT.MovieTicket_id) AS Total_Reservations,
    SUM(MT.seats) AS Total_Seats,
    AVG(MT.seats) AS Average_Seats,
    MAX(MT.seats) AS Maximum_Seats,
    MIN(MT.seats) AS Minimum_Seats
FROM MovieTicket MT
JOIN Movies M
    ON MT.movie_id = M.movie_id
GROUP BY M.title
ORDER BY M.title;



/*====================================================
    Total Reserved Seats Per Customer
====================================================*/
SELECT
    C.name,
    SUM(MT.seats) AS Total_Seats
FROM MovieTicket MT
JOIN Customers C
    ON MT.customer_id = C.customer_id
GROUP BY C.name;



/*====================================================
    Most Expensive Movie
====================================================*/
SELECT TOP 1 *
FROM Movies
ORDER BY price DESC;



/*====================================================
    Cheapest Movie
====================================================*/
SELECT TOP 1 *
FROM Movies
ORDER BY price ASC;



/*====================================================
    Reservation Cost Report
====================================================*/
SELECT
    C.name,
    M.title,
    H.hall_name,
    MT.seats,
    M.price,
    (MT.seats * M.price) AS Total_Price,
    MT.reservation_date
FROM MovieTicket MT
JOIN Customers C
    ON MT.customer_id = C.customer_id
JOIN Movies M
    ON MT.movie_id = M.movie_id
JOIN Halls H
    ON MT.hall_id = H.hall_id;



/*====================================================
    Movies Longer Than 160 Minutes
====================================================*/
SELECT *
FROM Movies
